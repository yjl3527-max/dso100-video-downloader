  "description": "DSO100|短视频创作者必备工具，支持抖音、小红书等平台。",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "popup16.png",
    "32": "popup32.png",
    "48": "popup48.png",
    "128": "popup128.png"
  },
  "action": {
    "default_icon": {
      "16": "popup16.png",
      "32": "popup32.png",
      "48": "popup48.png",
      "128": "popup128.png"
    },
    "default_title": "DSO100|短视频创作者必备工具",
    "default_popup": "popup.html"
  },
  "permissions": [
    "tabs",
    "webRequest",
    "downloads",
    "storage"
  ],
